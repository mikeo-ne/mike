# ---------------------------------------------------------------------------
# Personal AI Assistant — environment configuration
# Copy to `.env` and fill in values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Full Postgres connection string. If omitted, the app automatically falls
# back to an embedded PGlite (real Postgres, file-backed) database in ./data.
# Managed hosts (e.g. Arena's provisioned Postgres) may inject POSTGRES_URL
# instead — both are supported. In production, paste secrets via your host's
# Secrets Management panel rather than committing a .env file.
# Docker-compose default:
# DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant
DATABASE_URL=

# --- AI provider ------------------------------------------------------------
# Which provider powers the agent: "openai" or "anthropic".
AI_PROVIDER=openai

# Optional model override. Defaults when empty:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-4-20250514
AI_MODEL=

# At least one API key is required for live AI. Without a key for the selected
# provider the app runs in DEMO MODE (rule-based replies, real tool execution).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Free AI options ($0, no credit card) -------------------------------------
# Mike speaks the OpenAI API format, so any OpenAI-compatible provider works
# via OPENAI_BASE_URL (with its key in OPENAI_API_KEY and model in AI_MODEL).
# Groq free tier (recommended): sign up at groq.com → API Keys → create one
# (starts with gsk-..., no card required), then:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# Alternatives: OpenRouter free models (https://openrouter.ai/api/v1 plus a
# ":free" model), or local Ollama (http://localhost:11434/v1 + llama3.1).
OPENAI_BASE_URL=

# Max agentic tool-calling steps per chat turn.
AGENT_MAX_STEPS=6

# --- Google Calendar OAuth (optional) ---------------------------------------
# Create an OAuth Client ID (Web application) in Google Cloud Console and add
# the authorized redirect URI: https://<your-host>/api/calendar/google/callback
# (local: http://localhost:3000/api/calendar/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides; the redirect URI otherwise derives from APP_URL or the
# request origin.
GOOGLE_REDIRECT_URI=
APP_URL=
# 32-byte hex key for encrypting stored OAuth tokens at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Fallback scheduling webhook (optional) ----------------------------------
# Every calendar mutation payload is POSTed here (Cal.com, Make.com scenario,
# or any custom webhook). Without a URL the relay runs in mock mode.
CALENDAR_WEBHOOK_URL=
# Optional HMAC-SHA256 signing secret (sent as X-Mike-Signature header).
CALENDAR_WEBHOOK_SECRET=
